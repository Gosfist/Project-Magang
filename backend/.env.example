PORT=3001
# Pisahkan dengan koma bila ada lebih dari satu domain frontend.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL="mysql://root:@127.0.0.1:3306/unzanet"
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
JWT_EXPIRES_IN=7d
# Isi APP_KEY lama bila akun PPPoE dari Laravel masih menggunakan enkripsi Laravel.
LARAVEL_APP_KEY=

BOT_WHATSAPP_URL=http://localhost:3002
BOT_API_KEY=bot-wa-secret-key-change-me
