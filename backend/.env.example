PORT=3001
# Pisahkan dengan koma bila ada lebih dari satu origin frontend.
# Production Apache biasanya tanpa port, contoh: http://192.168.10.3
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://192.168.10.3
DATABASE_URL="mysql://root:@127.0.0.1:3306/unzanet"
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
JWT_EXPIRES_IN=7d
# Isi APP_KEY lama bila akun PPPoE dari Laravel masih menggunakan enkripsi Laravel.
LARAVEL_APP_KEY=

# URL internal dari backend ke bot WhatsApp. Di server yang sama, pakai 127.0.0.1.
BOT_WHATSAPP_URL=http://127.0.0.1:3002
# Harus sama persis dengan BOT_API_KEY di bot_whatsapp/.env.
BOT_API_KEY=ganti-dengan-key-yang-sama-dengan-bot

# Zona waktu authdate yang ditulis FreeRADIUS: WIB (default), WITA, WIT, atau UTC
RADIUS_LOG_TIMEZONE=WIB

# IP Ubuntu FreeRADIUS yang dapat dijangkau NAS melalui LAN/VPN.
# Boleh kosong jika diisi per NAS pada form Tambah Router.
RADIUS_SERVER_IP=
# IP sumber UDP Disconnect milik mesin backend; kosong = dipilih oleh routing OS.
# Harus sama dengan IP server yang diizinkan pada /radius dan firewall NAS.
RADIUS_DISCONNECT_SOURCE_IP=
# Zona penyimpanan DATETIME radacct, bukan zona tampilan browser.
# Pakai UTC jika database accounting sudah menyimpan waktu UTC.
RADIUS_ACCOUNTING_TIMEZONE=WIB
# Sesuaikan juga simul_count_query FreeRADIUS bila mengubah batas ini.
RADIUS_ACCOUNTING_STALE_SECONDS=900
