generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name     String
  email    String  @unique
  phone    String? @db.VarChar(30)
  photo    String? @db.LongText
  password String
  role     String  @default("teknisi") // admin, teknisi, finance, sales, kolektor
  status   String  @default("active")

  areaCollectors      AreaCollector[]
  collectorDeposits   CollectorDeposit[]   @relation("CollectorDeposits")
  acceptedDeposits    CollectorDeposit[]   @relation("AcceptedDeposits")
  financeTransactions FinanceTransaction[]
  salesOrders         PsbOrder[]           @relation("PsbSales")
  activatedOrders     PsbOrder[]           @relation("PsbActivatedBy")
  completedOrders     PsbOrder[]           @relation("PsbCompletedBy")

  @@map("users")
}

model MainCore {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  parentId      BigInt?    @map("parent_id") @db.UnsignedBigInt
  parentPortOut Int?       @map("parent_port_out") @db.UnsignedInt
  namaTitik     String     @unique @map("nama_titik")
  tipeTitik     String     @map("tipe_titik")
  redamanIn     Decimal?   @map("redaman_in") @db.Decimal(5, 2)
  jarakKabel    Decimal?   @map("jarak_kabel") @db.Decimal(10, 2)
  alamat        String?    @db.Text
  spesifikasi   Json?
  tanggal       DateTime?  @db.Date
  createdAt     DateTime?  @map("created_at")
  updatedAt     DateTime?  @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")
  parent        MainCore?  @relation("MainCoreTree", fields: [parentId], references: [id])
  children      MainCore[] @relation("MainCoreTree")

  @@index([parentId])
  @@index([parentPortOut])
  @@index([tipeTitik])
  @@map("main_core")
}

model PppoePackage {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name         String         @unique
  downloadMbps Int            @map("download_mbps") @db.UnsignedInt
  uploadMbps   Int            @map("upload_mbps") @db.UnsignedInt
  price        BigInt         @default(0) @db.UnsignedBigInt
  costPrice    BigInt         @default(0) @map("cost_price") @db.UnsignedBigInt
  addressPool  String?        @map("address_pool")
  ipPoolId     BigInt?        @map("ip_pool_id") @db.UnsignedBigInt
  validityDays Int            @default(30) @map("validity_days") @db.UnsignedInt
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime?      @map("created_at")
  updatedAt    DateTime?      @map("updated_at")
  accounts     PppoeAccount[]
  ipPool       IpPool?        @relation(fields: [ipPoolId], references: [id], onDelete: SetNull)
  psbOrders    PsbOrder[]

  @@index([ipPoolId])
  @@map("pppoe_packages")
}

model PppoeAccount {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  customerNumber   BigInt             @unique @map("customer_number") @db.UnsignedBigInt
  pppoePackageId   BigInt             @map("pppoe_package_id") @db.UnsignedBigInt
  customerName     String             @map("customer_name")
  idCardNumber     String?            @map("id_card_number") @db.VarChar(50)
  idCardPhoto      String?            @map("id_card_photo") @db.LongText
  username         String             @unique @db.VarChar(64)
  password         String             @db.Text
  phone            String?            @db.VarChar(30)
  address          String?            @db.Text
  latitude         Float?
  longitude        Float?
  subscriptionType String             @default("POSTPAID") @map("subscription_type") @db.VarChar(10)
  billingDay       Int                @default(1) @map("billing_day") @db.UnsignedInt
  discount         BigInt             @default(0) @db.UnsignedBigInt
  odp              String?            @db.VarChar(100)
  routerNasId      Int?               @map("router_nas_id") @db.UnsignedInt
  expiresAt        DateTime?          @map("expires_at") @db.Date
  isActive         Boolean            @default(true) @map("is_active")
  notes            String?            @db.Text
  createdAt        DateTime?          @map("created_at")
  updatedAt        DateTime?          @map("updated_at")
  package          PppoePackage       @relation(fields: [pppoePackageId], references: [id], onDelete: Restrict)
  areaId           BigInt?            @map("area_id") @db.UnsignedBigInt
  routerNas        Nas?               @relation(fields: [routerNasId], references: [id], onDelete: SetNull)
  area             Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  addons           CustomerAddon[]
  paymentPromises  PaymentPromise[]
  deposits         CollectorDeposit[]
  psbOrder         PsbOrder?

  @@index([pppoePackageId])
  @@index([routerNasId])
  @@index([areaId])
  @@map("pppoe_accounts")
}

model PsbOrder {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerNumber    BigInt    @unique @map("customer_number") @db.UnsignedBigInt
  customerName      String    @map("customer_name") @db.VarChar(150)
  phone             String    @db.VarChar(30)
  idCardNumber      String?   @map("id_card_number") @db.VarChar(50)
  idCardPhoto       String?   @map("id_card_photo") @db.LongText
  address           String    @db.Text
  latitude          Float?
  longitude         Float?
  pppoePackageId    BigInt    @map("pppoe_package_id") @db.UnsignedBigInt
  areaId            BigInt?   @map("area_id") @db.UnsignedBigInt
  salesUserId       BigInt    @map("sales_user_id") @db.UnsignedBigInt
  status            String    @default("PROCESS") @db.VarChar(20)
  username          String?   @db.VarChar(64)
  password          String?   @db.Text
  odp               String?   @db.VarChar(100)
  routerNasId       Int?      @map("router_nas_id") @db.UnsignedInt
  installationPhoto String?   @map("installation_photo") @db.LongText
  pppoeAccountId    BigInt?   @unique @map("pppoe_account_id") @db.UnsignedBigInt
  activatedByUserId BigInt?   @map("activated_by_user_id") @db.UnsignedBigInt
  completedByUserId BigInt?   @map("completed_by_user_id") @db.UnsignedBigInt
  activatedAt       DateTime? @map("activated_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  package     PppoePackage  @relation(fields: [pppoePackageId], references: [id], onDelete: Restrict)
  area        Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sales       User          @relation("PsbSales", fields: [salesUserId], references: [id])
  activatedBy User?         @relation("PsbActivatedBy", fields: [activatedByUserId], references: [id])
  completedBy User?         @relation("PsbCompletedBy", fields: [completedByUserId], references: [id])
  account     PppoeAccount? @relation(fields: [pppoeAccountId], references: [id], onDelete: SetNull)
  routerNas   Nas?          @relation(fields: [routerNasId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([salesUserId])
  @@index([pppoePackageId])
  @@map("psb_orders")
}

model IpPool {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name         String         @unique @db.VarChar(100)
  networkStart String         @map("network_start") @db.VarChar(45)
  networkEnd   String         @map("network_end") @db.VarChar(45)
  createdAt    DateTime?      @map("created_at")
  updatedAt    DateTime?      @map("updated_at")
  packages     PppoePackage[]

  @@map("ip_pools")
}

model Invoice {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  pppoeAccountId BigInt             @map("pppoe_account_id") @db.UnsignedBigInt
  invoiceNumber  String             @unique @map("invoice_number") @db.VarChar(50)
  amount         BigInt             @default(0) @db.UnsignedBigInt
  baseAmount     BigInt             @default(0) @map("base_amount") @db.UnsignedBigInt
  discount       BigInt             @default(0) @db.UnsignedBigInt
  invoiceType    String             @default("MONTHLY") @map("invoice_type") @db.VarChar(10)
  status         String             @default("PENDING") @db.VarChar(10)
  dueDate        DateTime           @map("due_date") @db.Date
  paidAt         DateTime?          @map("paid_at")
  notes          String?            @db.Text
  createdAt      DateTime?          @map("created_at")
  updatedAt      DateTime?          @map("updated_at")
  account        PppoeAccount       @relation(fields: [pppoeAccountId], references: [id], onDelete: Cascade)
  deposits       CollectorDeposit[]

  @@index([pppoeAccountId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model CustomerAddon {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  pppoeAccountId BigInt       @map("pppoe_account_id") @db.UnsignedBigInt
  name           String       @db.VarChar(150)
  amount         BigInt       @db.UnsignedBigInt
  feeType        String       @default("ONCE") @map("fee_type") @db.VarChar(15)
  notes          String?      @db.Text
  invoiceNumber  String       @map("invoice_number") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at")
  account        PppoeAccount @relation(fields: [pppoeAccountId], references: [id], onDelete: Cascade)

  @@index([pppoeAccountId])
  @@map("customer_addons")
}

model PaymentPromise {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  pppoeAccountId    BigInt       @map("pppoe_account_id") @db.UnsignedBigInt
  promisedDate      DateTime     @map("promised_date") @db.Date
  deadline          DateTime
  notes             String?      @db.Text
  status            String       @default("ACTIVE") @db.VarChar(15)
  invoiceIds        Json         @map("invoice_ids")
  originalExpiresAt DateTime?    @map("original_expires_at") @db.Date
  disconnectPending Boolean      @default(false) @map("disconnect_pending")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  account           PppoeAccount @relation(fields: [pppoeAccountId], references: [id], onDelete: Cascade)

  @@index([pppoeAccountId, status])
  @@index([status, deadline])
  @@map("payment_promises")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Radcheck {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("==") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([username])
  @@map("radcheck")
}

model Radreply {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("=") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([username])
  @@map("radreply")
}

model Radgroupcheck {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  groupname String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("==") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([groupname])
  @@map("radgroupcheck")
}

model Radgroupreply {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  groupname String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("=") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([groupname])
  @@map("radgroupreply")
}

model Radusergroup {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  groupname String @default("") @db.VarChar(64)
  priority  Int    @default(1)

  @@index([username])
  @@map("radusergroup")
}

model Radacct {
  radacctid           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  acctsessionid       String    @default("") @db.VarChar(64)
  acctuniqueid        String    @unique @db.VarChar(32)
  username            String    @default("") @db.VarChar(64)
  groupname           String    @default("") @db.VarChar(64)
  realm               String?   @db.VarChar(64)
  nasipaddress        String    @default("") @db.VarChar(45)
  nasportid           String?   @db.VarChar(32)
  nasporttype         String?   @db.VarChar(32)
  acctstarttime       DateTime?
  acctupdatetime      DateTime?
  acctstoptime        DateTime?
  acctinterval        Int?
  acctsessiontime     Int?      @db.UnsignedInt
  acctauthentic       String?   @db.VarChar(32)
  connectinfo_start   String?   @db.VarChar(50)
  connectinfo_stop    String?   @db.VarChar(50)
  acctinputoctets     BigInt?   @db.UnsignedBigInt
  acctoutputoctets    BigInt?   @db.UnsignedBigInt
  calledstationid     String    @default("") @db.VarChar(50)
  callingstationid    String    @default("") @db.VarChar(50)
  acctterminatecause  String    @default("") @db.VarChar(32)
  servicetype         String?   @db.VarChar(32)
  framedprotocol      String?   @db.VarChar(32)
  framedipaddress     String    @default("") @db.VarChar(45)
  framedipv6address   String    @default("") @db.VarChar(45)
  framedipv6prefix    String    @default("") @db.VarChar(45)
  framedinterfaceid   String    @default("") @db.VarChar(44)
  delegatedipv6prefix String    @default("") @db.VarChar(45)
  class               String?   @db.VarChar(64)

  @@index([acctsessionid])
  @@index([username])
  @@index([nasipaddress])
  @@index([acctstarttime])
  @@index([acctstoptime])
  @@map("radacct")
}

model Radpostauth {
  id       BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username String   @default("") @db.VarChar(64)
  pass     String   @default("") @db.VarChar(64)
  reply    String   @default("") @db.VarChar(32)
  authdate DateTime @default(now())
  class    String   @default("") @db.VarChar(64)

  @@map("radpostauth")
}

model VpnServer {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name         String      @db.VarChar(100)
  host         String      @db.VarChar(100)
  subnet       String      @default("10.200.0.0/24") @db.VarChar(50)
  wgPort       Int         @default(51820) @map("wg_port") @db.UnsignedInt
  wgPublicKey  String      @map("wg_public_key") @db.Text
  wgPrivateKey String?     @map("wg_private_key") @db.Text
  poolStart    Int         @default(10) @map("pool_start") @db.UnsignedInt
  poolEnd      Int         @default(254) @map("pool_end") @db.UnsignedInt
  gateway      String?     @db.VarChar(45)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime?   @default(now()) @map("created_at")
  updatedAt    DateTime?   @default(now()) @updatedAt @map("updated_at")
  clients      VpnClient[]

  @@map("vpn_servers")
}

model VpnClient {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name             String    @db.VarChar(100)
  vpnServerId      BigInt    @map("vpn_server_id") @db.UnsignedBigInt
  vpnIp            String    @map("vpn_ip") @db.VarChar(45)
  clientPublicKey  String    @map("client_public_key") @db.Text
  clientPrivateKey String?   @map("client_private_key") @db.Text
  allowedIps       String    @default("10.200.0.0/24") @map("allowed_ips") @db.VarChar(100)
  description      String?   @db.Text
  isRadiusServer   Boolean   @default(false) @map("is_radius_server")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at")
  vpnServer        VpnServer @relation(fields: [vpnServerId], references: [id], onDelete: Cascade)
  routers          Nas[]

  @@index([vpnServerId])
  @@index([vpnIp])
  @@map("vpn_clients")
}

model Nas {
  id              Int            @id @default(autoincrement()) @db.UnsignedInt
  name            String?        @db.VarChar(100)
  nasname         String         @db.VarChar(128)
  shortname       String?        @db.VarChar(32)
  type            String         @default("mikrotik") @db.VarChar(30)
  authMode        String         @default("radius") @map("auth_mode") @db.VarChar(20)
  ipAddress       String?        @map("ip_address") @db.VarChar(45)
  username        String?        @db.VarChar(64)
  password        String?        @db.Text
  port            Int?           @default(8728) @db.UnsignedInt
  ports           Int?           @default(1812) @db.UnsignedSmallInt
  secret          String         @default("secret") @db.VarChar(60)
  server          String?        @db.VarChar(64)
  community       String?        @db.VarChar(50)
  description     String?        @default("RADIUS Client") @db.VarChar(200)
  vpnClientId     BigInt?        @map("vpn_client_id") @db.UnsignedBigInt
  latitude        Float?
  longitude       Float?
  isActive        Boolean        @default(true) @map("is_active")
  requireMa       String         @default("auto") @map("require_ma") @db.VarChar(4)
  limitProxyState String         @default("auto") @map("limit_proxy_state") @db.VarChar(4)
  createdAt       DateTime?      @default(now()) @map("created_at")
  updatedAt       DateTime?      @default(now()) @updatedAt @map("updated_at")
  accounts        PppoeAccount[]
  psbOrders       PsbOrder[]
  vpnClient       VpnClient?     @relation(fields: [vpnClientId], references: [id], onDelete: SetNull)

  @@index([nasname])
  @@index([vpnClientId])
  @@map("nas")
}

model Nasreload {
  nasipaddress String   @id @db.VarChar(45)
  reloadtime   DateTime

  @@map("nasreload")
}

model MonitoringError {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")
  method    String   @db.VarChar(16)
  route     String   @db.VarChar(255)
  status    Int

  @@map("monitoring_errors")
}

model ActivityLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at")
  userName    String   @map("user_name") @db.VarChar(255)
  role        String   @db.VarChar(30)
  module      String   @db.VarChar(40)
  action      String   @db.VarChar(40)
  description String   @db.VarChar(500)
  status      String   @db.VarChar(20)

  @@index([createdAt])
  @@map("activity_logs")
}

model ServerStat {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  recordedAt DateTime @map("recorded_at")
  cpuPercent Float    @map("cpu_percent")
  memPercent Float    @map("mem_percent")
  memUsed    BigInt   @map("mem_used") @db.UnsignedBigInt
  memTotal   BigInt   @map("mem_total") @db.UnsignedBigInt
  netDown    Float    @map("net_down")
  netUp      Float    @map("net_up")

  @@index([recordedAt])
  @@map("server_stats")
}

model RouterStat {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nasId      Int      @map("nas_id") @db.UnsignedInt
  recordedAt DateTime @map("recorded_at")
  cpuPercent Float    @map("cpu_percent")
  memPercent Float    @map("mem_percent")
  memFree    BigInt   @map("mem_free") @db.UnsignedBigInt
  memTotal   BigInt   @map("mem_total") @db.UnsignedBigInt
  netDown    Float    @map("net_down")
  netUp      Float    @map("net_up")
  uptime     BigInt   @default(0) @db.UnsignedBigInt

  @@index([nasId, recordedAt])
  @@index([recordedAt])
  @@map("router_stats")
}

model ServerStatMonthly {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  year       Int    @db.UnsignedSmallInt
  month      Int    @db.UnsignedTinyInt
  cpuPercent Float  @map("cpu_percent")
  memPercent Float  @map("mem_percent")
  netDown    Float  @map("net_down")
  netUp      Float  @map("net_up")
  samples    Int    @default(0) @db.UnsignedInt

  @@unique([year, month])
  @@map("server_stats_monthly")
}

model RouterStatMonthly {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  nasId      Int    @map("nas_id") @db.UnsignedInt
  year       Int    @db.UnsignedSmallInt
  month      Int    @db.UnsignedTinyInt
  cpuPercent Float  @map("cpu_percent")
  memPercent Float  @map("mem_percent")
  netDown    Float  @map("net_down")
  netUp      Float  @map("net_up")
  samples    Int    @default(0) @db.UnsignedInt

  @@unique([nasId, year, month])
  @@map("router_stats_monthly")
}

model ServerStatYearly {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  year       Int    @unique @db.UnsignedSmallInt
  cpuPercent Float  @map("cpu_percent")
  memPercent Float  @map("mem_percent")
  netDown    Float  @map("net_down")
  netUp      Float  @map("net_up")
  samples    Int    @default(0) @db.UnsignedInt

  @@map("server_stats_yearly")
}

model RouterStatYearly {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  nasId      Int    @map("nas_id") @db.UnsignedInt
  year       Int    @db.UnsignedSmallInt
  cpuPercent Float  @map("cpu_percent")
  memPercent Float  @map("mem_percent")
  netDown    Float  @map("net_down")
  netUp      Float  @map("net_up")
  samples    Int    @default(0) @db.UnsignedInt

  @@unique([nasId, year])
  @@map("router_stats_yearly")
}

model Area {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  name        String          @unique @db.VarChar(150)
  description String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  collectors  AreaCollector[]
  accounts    PppoeAccount[]
  psbOrders   PsbOrder[]

  @@map("areas")
}

model AreaCollector {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  areaId    BigInt   @map("area_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([areaId, userId])
  @@index([userId])
  @@map("area_collectors")
}

model CollectorDeposit {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  pppoeAccountId   BigInt    @map("pppoe_account_id") @db.UnsignedBigInt
  invoiceId        BigInt    @map("invoice_id") @db.UnsignedBigInt
  collectorUserId  BigInt    @map("collector_user_id") @db.UnsignedBigInt
  amount           BigInt    @db.UnsignedBigInt
  depositDate      DateTime  @map("deposit_date") @db.Date
  status           String    @default("PENDING") @db.VarChar(20)
  acceptedByUserId BigInt?   @map("accepted_by_user_id") @db.UnsignedBigInt
  acceptedAt       DateTime? @map("accepted_at")
  notes            String?   @db.Text
  receiptPhoto     String?   @map("receipt_photo") @db.LongText
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  account    PppoeAccount @relation(fields: [pppoeAccountId], references: [id], onDelete: Cascade)
  invoice    Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  collector  User         @relation("CollectorDeposits", fields: [collectorUserId], references: [id])
  acceptedBy User?        @relation("AcceptedDeposits", fields: [acceptedByUserId], references: [id])

  @@index([pppoeAccountId])
  @@index([collectorUserId])
  @@index([status])
  @@map("collector_deposits")
}

model FinanceTransaction {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  type            String   @db.VarChar(15)
  category        String   @db.VarChar(50)
  amount          BigInt   @db.UnsignedBigInt
  description     String   @db.VarChar(500)
  referenceType   String?  @map("reference_type") @db.VarChar(30)
  referenceId     BigInt?  @map("reference_id") @db.UnsignedBigInt
  createdByUserId BigInt   @map("created_by_user_id") @db.UnsignedBigInt
  transactionDate DateTime @map("transaction_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([type])
  @@index([transactionDate])
  @@index([createdByUserId])
  @@map("finance_transactions")
}
