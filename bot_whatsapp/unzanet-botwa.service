[Unit]
Description=Unzanet WhatsApp Bot
After=network.target mysql.service

[Service]
Type=simple
User=user
WorkingDirectory=/var/www/Project-Magang/bot_whatsapp
ExecStart=/usr/bin/node /var/www/Project-Magang/bot_whatsapp/src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
