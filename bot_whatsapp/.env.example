PORT=3002
# Backend NestJS untuk memverifikasi token dan role admin.
BACKEND_URL=http://127.0.0.1:3001
# Origin frontend yang membuka dashboard. Production Apache biasanya tanpa port.
FRONTEND_URL=http://192.168.10.3
DATABASE_URL="mysql://root:@127.0.0.1:3306/unzanet"
# Harus sama persis dengan BOT_API_KEY di backend/.env.
BOT_API_KEY=ganti-dengan-key-yang-sama-dengan-backend
JWT_SECRET=ganti-dengan-random-secret-yang-sama-dengan-backend
